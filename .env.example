# Copy to .env for local development. Never commit real values.

# PostgreSQL connection string. Leave empty locally to use a JSON file in data/.
# Required in production (the server refuses to start without it).
DATABASE_URL=

# Schema the app creates and uses inside that database (default: saphire_card).
# DB_SCHEMA=saphire_card

# Admin PIN set the first time the database is initialized (6+ characters).
# If unset, a random PIN is generated and printed in the server logs.
ADMIN_PIN=

# Recovery only: overwrites the stored PIN on every start. Remove it after logging in.
# ADMIN_PIN_RESET=

# Force TLS for the database connection (automatic for *.render.com hosts).
# DATABASE_SSL=true
